# DEVSphere Environment Configuration Example
# Copy this file to .env or set environment variables before running in production

# Spring Boot / PostgreSQL Database Settings
# For Render / IPv4 cloud deployment with Supabase, use the Connection Pooler on port 5432:
DEVSphere_DB_URL=jdbc:postgresql://aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require
DEVSphere_DB_USERNAME=postgres.your_supabase_project_ref
DEVSphere_DB_PASSWORD=your_secure_password_here

# JWT Secret (Base64 string or 256-bit plain text key)
DEVSphere_JWT_SECRET=4c9b1d75f284e60183b9e4a7d6c518293f0b4d7e1c8a5f3962b0e8c71d4a6f95

# CORS Allowed Origins (Comma-separated)
DEVSphere_CORS_ORIGINS=https://dev-sphere-eight.vercel.app,http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Frontend Vite API Base URL (Used by src/services/api.js)
VITE_API_BASE_URL=http://localhost:8080
