# DEVSphere Environment Configuration Example
# Copy this file to .env or set environment variables before running in production

# Spring Boot / PostgreSQL Database Settings
DEVSphere_DB_URL=jdbc:postgresql://localhost:5432/devsphere
DEVSphere_DB_USERNAME=postgres
DEVSphere_DB_PASSWORD=your_secure_password_here

# JWT Secret (Base64 string or 256-bit plain text key)
DEVSphere_JWT_SECRET=devsphere_super_secret_jwt_key_that_is_long_enough_for_hmac_sha256_32bytes

# CORS Allowed Origins (Comma-separated)
DEVSphere_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Frontend Vite API Base URL (Used by src/services/api.js)
VITE_API_BASE_URL=http://localhost:8080/api/v1
